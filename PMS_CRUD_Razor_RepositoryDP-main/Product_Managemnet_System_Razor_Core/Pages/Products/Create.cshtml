@page
@model Product_Managemnet_System_Razor_Core.Pages.Products.CreateModel

@{
    ViewData["Title"] = "Add New Product";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom">
                <div class="d-flex align-items-center">
                    <a asp-page="Index" class="btn btn-sm btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <h4 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-plus-square text-primary me-2"></i>Create New Product
                    </h4>
                </div>
            </div>

            <div class="card-body p-4">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Product.Title" class="form-label fw-semibold">
                            Title <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Product.Title" class="form-control" placeholder="e.g. Wireless Gaming Mouse" />
                        <span asp-validation-for="Product.Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.description" class="form-label fw-semibold">
                            Description <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Product.description" class="form-control" rows="3" placeholder="Enter product specifications and details..."></textarea>
                        <span asp-validation-for="Product.description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageFile" class="form-label fw-semibold">
                            Product Image <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                        <div class="form-text">Allowed formats: JPG, JPEG, PNG, WEBP (Max 5MB).</div>
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Product.price" class="form-label fw-semibold">
                                Price <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Product.price" type="number" min="0" class="form-control" placeholder="0" />
                            </div>
                            <span asp-validation-for="Product.price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Product.quantity" class="form-label fw-semibold">
                                Quantity in Stock <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Product.quantity" type="number" min="0" class="form-control" placeholder="0" />
                            <span asp-validation-for="Product.quantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Product.status" class="form-label fw-semibold">Status</label>
                        <select asp-for="Product.status" class="form-select">
                            <option value="A">Active</option>
                            <option value="I">Inactive</option>
                        </select>
                        <span asp-validation-for="Product.status" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-page="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Save Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
