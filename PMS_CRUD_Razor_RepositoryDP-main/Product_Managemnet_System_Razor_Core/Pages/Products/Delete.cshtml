@page "{id:int}"
@model Product_Managemnet_System_Razor_Core.Pages.Products.DeleteModel

@{
    ViewData["Title"] = "Confirm Delete Product";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Confirmation
                </h5>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill fs-4 me-3 text-warning"></i>
                    <div>
                        Are you sure you want to permanently delete this product? This action cannot be undone.
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded border mb-4">
                    @if (!string.IsNullOrEmpty(Model.Product.image))
                    {
                        <img src="@Url.Content("~/" + Model.Product.image)"
                             alt="@Model.Product.Title"
                             class="rounded border shadow-sm"
                             style="width:80px; height:80px; object-fit:cover;" />
                    }
                    <div>
                        <h5 class="fw-bold text-dark mb-1">@Model.Product.Title</h5>
                        <div class="text-muted small mb-1">ID: #@Model.Product.Id</div>
                        <div class="fw-semibold text-danger">Price: $@Model.Product.price.ToString("N0") | Quantity: @Model.Product.quantity</div>
                    </div>
                </div>

                <form method="post" class="d-flex justify-content-end gap-2">
                    <a asp-page="Index" class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger px-4 shadow-sm">
                        <i class="bi bi-trash3 me-1"></i> Confirm Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
