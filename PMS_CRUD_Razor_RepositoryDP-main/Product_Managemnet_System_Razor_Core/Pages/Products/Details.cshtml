@page "{id:int}"
@model Product_Managemnet_System_Razor_Core.Pages.Products.DetailsModel

@{
    ViewData["Title"] = "Product Details - " + Model.Product.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <a asp-page="Index" class="btn btn-sm btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <h4 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-info-circle text-info me-2"></i>Product Details
                    </h4>
                </div>
                <span class="badge bg-light text-muted border">ID: #@Model.Product.Id</span>
            </div>

            <div class="card-body p-4">
                <div class="row g-4 align-items-center">
                    <div class="col-md-5 text-center">
                        @if (!string.IsNullOrEmpty(Model.Product.image))
                        {
                            <img src="@Url.Content("~/" + Model.Product.image)"
                                 alt="@Model.Product.Title"
                                 class="img-fluid rounded border shadow-sm"
                                 style="max-height: 260px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light rounded border py-5 text-muted">
                                <i class="bi bi-image display-4 d-block mb-2"></i>
                                <span>No Image Available</span>
                            </div>
                        }
                    </div>

                    <div class="col-md-7">
                        <h3 class="fw-bold text-dark mb-2">@Model.Product.Title</h3>

                        <div class="mb-3">
                            @if (Model.Product.status == "A" || Model.Product.status == "Available" || Model.Product.status == "Active")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                    <i class="bi bi-check-circle me-1"></i> Active / Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2">
                                    <i class="bi bi-x-circle me-1"></i> Inactive
                                </span>
                            }
                        </div>

                        <div class="mb-3">
                            <span class="text-muted small d-block">Price:</span>
                            <span class="fs-4 fw-bold text-success">$@Model.Product.price.ToString("N0")</span>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted small d-block">Current Stock:</span>
                            <span class="fw-semibold">@Model.Product.quantity units</span>
                        </div>

                        <div class="mb-4">
                            <span class="text-muted small d-block">Description:</span>
                            <p class="text-secondary bg-light p-3 rounded border mb-0">
                                @Model.Product.description
                            </p>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-page="Edit" asp-route-id="@Model.Product.Id" class="btn btn-warning px-4 shadow-sm text-dark fw-semibold">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                            <a asp-page="Index" class="btn btn-outline-secondary px-4">
                                Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
